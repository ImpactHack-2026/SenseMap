# SenseMap environment variables

# Copy this file to a local env file and fill in real values. That file is
# git-ignored - never commit real keys.
#
# Provider order: official Google Places API -> SerpAPI -> labeled demo data.
# The AI review analyzer uses the OpenAI-compatible endpoint below.

# --- AI review analyzer (OpenAI-compatible chat endpoint) ---
# Any OpenAI-compatible gateway works (Groq, OpenRouter, OpenAI, ...).
# Example base URL for Groq: https://api.groq.com/openai/v1
OPENAI_API_KEY="XXX"
OPENAI_BASE_URL="XXX"
OPENAI_MODEL="XXX"

# --- Google Places (official channel, optional) ---
# When present, the official Google Places API is used as the primary
# retrieval channel and SerpAPI is inactive.
GOOGLE_PLACES_API_KEY="XXX"

# --- SerpAPI (fallback retrieval channel) ---
# Used when GOOGLE_PLACES_API_KEY is absent. Free tier is ~100 searches/month;
# a 1-hour server cache makes repeat lookups free.
SERPAPI_KEY="XXX"

# --- Supabase (app data: saves, feedback, notes) ---
# Without these the app runs without persistence and returns
# 503 db_not_configured for write endpoints.
SUPABASE_URL="XXX"
SUPABASE_SERVICE_ROLE_KEY="XXX"
SUPABASE_DB_URL="XXX"
